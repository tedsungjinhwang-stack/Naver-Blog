# ==========================================================================
# nbpipe 환경변수 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.
#
# 본문은 이 세션의 Claude(또는 사람)가 직접 작성하므로 LLM API 키가 필요 없습니다.
# 아래 키는 전부 '선택' 입니다. (없으면 해당 수집기만 자동 skip)
# ==========================================================================

# --- 선택: 네이버 DataLab 검색어 트렌드 ---
# https://developers.naver.com/ 애플리케이션 등록 후 발급 (검색/데이터랩 API)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 선택: 출력 경로 오버라이드 ---
# NBPIPE_OUTPUT_DIR=./output

# --- 선택: 무료 이미지 API (tools/fetch_images.py) ---
# openverse 는 키가 필요 없다. 아래는 더 고화질 스톡을 쓰고 싶을 때만 발급.
# https://www.pexels.com/api/  →  PEXELS_API_KEY
PEXELS_API_KEY=
# https://unsplash.com/developers  →  UNSPLASH_ACCESS_KEY
UNSPLASH_ACCESS_KEY=
